{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Agent Server",
      "type": "shell",
      "command": "${workspaceFolder}\\src\\agent-framework-agent-basic-responses\\.venv\\Scripts\\python.exe",
      "args": [
        "-m", "debugpy", "--listen", "127.0.0.1:5679",
        "main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\src\\agent-framework-agent-basic-responses"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process"
        }
      }
    },
    {
      "label": "Open Agent Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "dependsOn": ["Run Agent Server"],
      "presentation": { "reveal": "never" }
    },
    {
      "label": "Terminate All Tasks",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": { "triggeredFrom": "tasks", "port": 8088 }
    },
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
